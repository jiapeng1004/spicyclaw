{
  "name": "spicyclaw",
  "private": true,
  "description": "SpicyClaw 客户端 monorepo（@spicyclaw/web 在 front/ 目录 + spicyclaw-desktop）；后端 pom.xml，移动端 mobile/",
  "workspaces": [
    "front",
    "desktop"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @spicyclaw/web",
    "dev:desktop": "npm run dev -w spicyclaw-desktop",
    "build:web": "npm run build -w @spicyclaw/web",
    "build:desktop": "npm run build -w spicyclaw-desktop",
    "pack:desktop": "npm run pack -w spicyclaw-desktop",
    "dist:desktop": "npm run dist -w spicyclaw-desktop",
    "install:clients": "npm install"
  }
}
